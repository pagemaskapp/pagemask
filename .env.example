# PageMask — modelo de variáveis de ambiente
#
# Copie para `app/.env.local` (o Next lê de lá) e preencha. Nunca commite o
# arquivo preenchido: `.env*` está no .gitignore e o gitleaks roda no CI.
#
# Regra que vale para o arquivo inteiro (docs/PLANO.md §3):
#   NEXT_PUBLIC_* vai para o bundle do navegador e é público por definição.
#   Todo o resto é segredo e só existe no servidor e no worker.
#   Dev e produção usam chaves DIFERENTES, sempre.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — Dashboard > Project Settings > API
#
# Este projeto ainda usa as chaves LEGADAS (formato JWT, `eyJ…`). O Supabase as
# descontinua no fim de 2026 e as substitui por `sb_publishable_` / `sb_secret_`.
# Quando as novas aparecerem no painel, basta trocar o VALOR destas duas linhas:
# a validação do app aceita os dois formatos e confere o papel da chave nos dois.
#
# Cuidado que só existe no formato legado: a `anon` e a `service_role` são as
# duas `eyJ…`, idênticas por fora. O que separa uma da outra é o claim `role`
# dentro do token. Trocar as duas de lugar publica no navegador uma chave que
# ignora a RLS inteira — por isso o app decodifica o `role` antes de aceitar.
# ─────────────────────────────────────────────────────────────────────────────

# Project Settings > API > Project URL. Formato: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings > API > Project API keys > `anon` `public`.
# Pública por natureza: vai para o bundle do navegador, e quem protege o dado é
# a RLS, não o segredo desta chave. Precisa ter role=anon.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings > API > Project API keys > `service_role` `secret`.
# IGNORA RLS por completo. Só servidor e worker, nunca em NEXT_PUBLIC_*, nunca
# no navegador, nunca colada em chat ou ticket. Precisa ter role=service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings > Database > Connection string (URI, modo session).
# Usada para aplicar as migrations e pelo worker. Contém a senha do banco.
# Formato: postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 — Dashboard > R2 > Manage R2 API Tokens
# Crie um token de escopo "Object Read & Write" restrito ao bucket do PageMask.
# Bucket privado, sem domínio público: tudo sai por URL pré-assinada.
# ─────────────────────────────────────────────────────────────────────────────

# R2 > Overview, canto direito ("Account ID").
R2_ACCOUNT_ID=

# Mostrados uma única vez, na criação do token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nome do bucket. Lifecycle de 30 dias configurado no painel do R2.
R2_BUCKET=pagemask

# Endpoint S3 do R2: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ─────────────────────────────────────────────────────────────────────────────
# Stripe — Dashboard > Developers > API keys
# ─────────────────────────────────────────────────────────────────────────────

# Developers > API keys > Publishable key (`pk_test_…` / `pk_live_…`).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Developers > API keys > Secret key (`sk_test_…` / `sk_live_…`).
STRIPE_SECRET_KEY=

# Developers > Webhooks > (endpoint) > Signing secret. Sem ele não há
# `constructEvent`, e sem `constructEvent` qualquer um posta um webhook falso.
# Formato: whsec_…
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Instagram — developers.facebook.com > seu app > Instagram > API setup with
# Instagram login. Não é o Facebook Login: é o Business Login for Instagram,
# em graph.instagram.com, sem Página do Facebook.
# ─────────────────────────────────────────────────────────────────────────────

# "Instagram app ID" (não confundir com o App ID do app do Facebook).
IG_APP_ID=

# "Instagram app secret".
IG_APP_SECRET=

# Precisa ser idêntica à URI cadastrada em "OAuth redirect URIs".
IG_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# ─────────────────────────────────────────────────────────────────────────────
# Segurança — geradas por você, uma por ambiente
# ─────────────────────────────────────────────────────────────────────────────

# Chave AES-256-GCM que cifra o token do Instagram em repouso. 32 bytes:
#   openssl rand -base64 32
# Perder esta chave = perder todos os tokens (todo cliente reconecta).
# Vazar esta chave = vazar todos os tokens. Rotação em docs/RUNBOOK.md.
TOKEN_ENC_KEY=

# Protege as rotas de cron (renovar token, publicar agendado, expirar job).
# Vai no header da chamada do Vercel Cron.
#   openssl rand -hex 32
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Sentry — sentry.io > Settings > Projects > (projeto) > Client Keys (DSN)
# ─────────────────────────────────────────────────────────────────────────────

# DSN é público por natureza (vai no navegador). Não é credencial.
NEXT_PUBLIC_SENTRY_DSN=

# Settings > Auth Tokens. Só no CI e no build: sobe os source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────

# Origem canônica. Em produção: https://pagemask.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000
