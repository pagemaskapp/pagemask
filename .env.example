# PageMask — modelo de variáveis de ambiente
#
# Copie para `app/.env.local` (o Next lê de lá) e preencha. Nunca commite o
# arquivo preenchido: `.env*` está no .gitignore e o gitleaks roda no CI.
#
# Regra que vale para o arquivo inteiro (docs/PLANO.md §3):
#   NEXT_PUBLIC_* vai para o bundle do navegador e é público por definição.
#   Todo o resto é segredo e só existe no servidor e no worker.
#   Dev e produção usam chaves DIFERENTES, sempre.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — Dashboard > Project Settings > API
#
# Este projeto ainda usa as chaves LEGADAS (formato JWT, `eyJ…`). O Supabase as
# descontinua no fim de 2026 e as substitui por `sb_publishable_` / `sb_secret_`.
# Quando as novas aparecerem no painel, basta trocar o VALOR destas duas linhas:
# a validação do app aceita os dois formatos e confere o papel da chave nos dois.
#
# Cuidado que só existe no formato legado: a `anon` e a `service_role` são as
# duas `eyJ…`, idênticas por fora. O que separa uma da outra é o claim `role`
# dentro do token. Trocar as duas de lugar publica no navegador uma chave que
# ignora a RLS inteira — por isso o app decodifica o `role` antes de aceitar.
# ─────────────────────────────────────────────────────────────────────────────

# Project Settings > API > Project URL. Formato: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings > API > Project API keys > `anon` `public`.
# Pública por natureza: vai para o bundle do navegador, e quem protege o dado é
# a RLS, não o segredo desta chave. Precisa ter role=anon.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings > API > Project API keys > `service_role` `secret`.
# IGNORA RLS por completo. Só servidor e worker, nunca em NEXT_PUBLIC_*, nunca
# no navegador, nunca colada em chat ou ticket. Precisa ter role=service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings > API > JWT Settings > JWT Secret.
#
# OPCIONAL, e o que ela liga e so uma coisa: o progresso AO VIVO da lista de
# videos (Fase 3). Com ela, o servidor assina um token de 5 minutos que
# autoriza o Supabase Realtime no navegador; sem ela, a lista se atualiza
# sozinha a cada 8 segundos e nenhum token chega ao navegador. As duas opcoes
# sao legitimas — a segunda e mais lenta e mais fechada.
#
# Por que nao se usa aqui o token da sessao: ele e `HttpOnly` desde a Fase 1,
# justamente para ficar fora do alcance de JavaScript, e vale 1 hora. O token
# assinado com esta chave vale 5 minutos e nao tem como ser renovado sem passar
# de novo por uma rota que exige a sessao.
#
# CUIDADO: esta e a chave que ASSINA a `anon` e a `service_role`. Vazar ela e
# pior do que vazar a `service_role` — permite forjar qualquer identidade do
# projeto. So no servidor, nunca em NEXT_PUBLIC_*.
#
# E preciso saber o que se ganha e o que se paga ao preenche-la: com ela, todo
# usuario que abre um projeto recebe no navegador um JWT de 5 minutos assinado
# por esta chave. Ele NAO e limitado ao Realtime — Supabase nao tem esse
# escopo —, entao vale tambem contra o PostgREST, dentro do que a RLS daquele
# usuario permite. Um XSS no app passa a render um token de API alem da
# sessao. A CSP da Fase 1 (nonce, sem `unsafe-inline`) e o que segura esse
# risco; deixar a variavel em branco o elimina, ao custo da latencia.
SUPABASE_JWT_SECRET=

# Project Settings > Database > Connection string (URI, modo session).
# Usada para aplicar as migrations e pelo worker. Contém a senha do banco.
# Formato: postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 — Dashboard > R2 > Manage R2 API Tokens
# Crie um token de escopo "Object Read & Write" restrito ao bucket do PageMask.
# Bucket privado, sem domínio público: tudo sai por URL pré-assinada.
# ─────────────────────────────────────────────────────────────────────────────

# R2 > Overview, canto direito ("Account ID").
R2_ACCOUNT_ID=

# Mostrados uma única vez, na criação do token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nome do bucket. Lifecycle de 30 dias configurado no painel do R2.
R2_BUCKET=pagemask

# Endpoint S3 do R2: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ─────────────────────────────────────────────────────────────────────────────
# Stripe — Dashboard > Developers > API keys
# ─────────────────────────────────────────────────────────────────────────────

# Developers > API keys > Publishable key (`pk_test_…` / `pk_live_…`).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Developers > API keys > Secret key (`sk_test_…` / `sk_live_…`).
STRIPE_SECRET_KEY=

# Developers > Webhooks > (endpoint) > Signing secret. Sem ele não há
# `constructEvent`, e sem `constructEvent` qualquer um posta um webhook falso.
# Formato: whsec_…
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Instagram — developers.facebook.com > seu app > Instagram > API setup with
# Instagram login. Não é o Facebook Login: é o Business Login for Instagram,
# em graph.instagram.com, sem Página do Facebook.
# ─────────────────────────────────────────────────────────────────────────────

# "Instagram app ID" (não confundir com o App ID do app do Facebook).
IG_APP_ID=

# "Instagram app secret".
IG_APP_SECRET=

# Precisa ser idêntica, caractere por caractere, à URI cadastrada em "OAuth
# redirect URIs" no painel da Meta — ela entra na assinatura da troca do code, e
# uma barra a mais faz a troca falhar com uma mensagem que não diz isso.
#
# A Meta exige HTTPS, inclusive em localhost. Para desenvolver:
#   npm run dev -- --experimental-https
# (o Next gera um certificado autoassinado na primeira execução).
IG_REDIRECT_URI=https://localhost:3000/api/ig/callback

# `development` (padrão) ou `live`. Em `development` a tela de Conectores
# mostra a faixa avisando que só contas convidadas como tester conseguem
# conectar. Mude para `live` quando o app sair da revisão da Meta.
IG_APP_MODE=development

# ─────────────────────────────────────────────────────────────────────────────
# Segurança — geradas por você, uma por ambiente
# ─────────────────────────────────────────────────────────────────────────────

# Chave AES-256-GCM que cifra o token do Instagram em repouso. 32 bytes:
#   openssl rand -base64 32
# Perder esta chave = perder todos os tokens (todo cliente reconecta).
# Vazar esta chave = vazar todos os tokens. Rotação em docs/RUNBOOK.md.
TOKEN_ENC_KEY=

# Vale também para o WORKER (Fase 5): é ela que decifra o token na hora de
# publicar. O compose lê TOKEN_ENC_KEY do ambiente/`.env` da pasta worker/;
# sem ela o worker sobe, renderiza, e avisa no log que a publicação está
# desligada.
# Protege as rotas de cron (renovar token, publicar agendado, expirar job).
# O Vercel Cron manda sozinho como `Authorization: Bearer <valor>`; um disparo
# manual pode usar `x-cron-secret: <valor>`. EM BRANCO, a rota de cron responde
# 401 a tudo — ela falha fechada de propósito.
#   openssl rand -hex 32
CRON_SECRET=

# Cron de publicação (`/api/cron/publicar`, a cada minuto em app/vercel.json).
# Cron por minuto é recurso do plano Pro da Vercel — no Hobby o menor intervalo
# é diário, e sem o cron nada vira `publishing`. Alternativa fora da Vercel:
# qualquer agendador chamando a rota com o header `x-cron-secret`.

# ─────────────────────────────────────────────────────────────────────────────
# E-mail transacional — resend.com > API Keys
#
# OPCIONAL. Usado quando a renovação do token do Instagram falha em definitivo:
# o cliente recebe um aviso para reconectar. Sem as duas variáveis, o aviso vai
# só para o log — a conta continua sendo marcada como "precisa reconectar" no
# banco, que é o que faz a tela pedir a reconexão.
# ─────────────────────────────────────────────────────────────────────────────

RESEND_API_KEY=

# Remetente verificado no provedor. Ex.: PageMask <avisos@pagemask.com.br>
EMAIL_REMETENTE=

# ─────────────────────────────────────────────────────────────────────────────
# Sentry — sentry.io > Settings > Projects > (projeto) > Client Keys (DSN)
# ─────────────────────────────────────────────────────────────────────────────

# DSN é público por natureza (vai no navegador). Não é credencial.
NEXT_PUBLIC_SENTRY_DSN=

# Settings > Auth Tokens. Só no CI e no build: sobe os source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────

# Origem canônica. Em produção: https://pagemask.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000
